<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Glint.UI.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>

      <!-- ===================== Glint palette (Section 3 — locked) ===================== -->
      <SolidColorBrush x:Key="BgPrimaryBrush" Color="#121214"/>
      <SolidColorBrush x:Key="BgPanelBrush" Color="#1A1A1D"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#4ECBF0"/>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D8DADC"/>
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6A6A8A"/>

      <!-- ===================== Fluent accent retint (cyan) =====================
           FluentTheme derives accent-dependent controls (ToggleSwitch, focus rings,
           default Slider fill) from these. Shades are generated by lightening/darkening
           the base accent — exact shade values are cosmetic and safe to tweak. -->
      <Color x:Key="SystemAccentColor">#4ECBF0</Color>
      <Color x:Key="SystemAccentColorLight1">#7BD8F5</Color>
      <Color x:Key="SystemAccentColorLight2">#A3E4F8</Color>
      <Color x:Key="SystemAccentColorLight3">#CBF1FB</Color>
      <Color x:Key="SystemAccentColorDark1">#3FA9C9</Color>
      <Color x:Key="SystemAccentColorDark2">#2F87A2</Color>
      <Color x:Key="SystemAccentColorDark3">#1F647A</Color>

      <!-- Slider track/thumb retint — falls back gracefully to the accent colors above
           if these specific resource keys differ slightly from the Fluent version in use. -->
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#4ECBF0"/>
      <SolidColorBrush x:Key="SliderTrackFill" Color="#2A2A2E"/>
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#4ECBF0"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#7BD8F5"/>
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#3FA9C9"/>

    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Glint.UI/Styles/Theme.axaml"/>
  </Application.Styles>

</Application>
